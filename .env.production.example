# Comunora - producao OCI/Docker

# ---- Banco / Redis ----
DATABASE_URL=
DATABASE_ADMIN_URL=
DATABASE_RUNTIME_USER=plataforma_runtime
DATABASE_RUNTIME_PASSWORD=
REDIS_URL=

# ---- Runtime ----
NODE_ENV=production
PUBLIC_REGISTRATION_ENABLED=false
PORT=3000
JWT_SECRET=
SECRETS_MASTER_KEY=
PUBLIC_BRAND_NAME=Comunora
HTTP_BODY_LIMIT=25mb

# ---- Dominios oficiais ----
WEB_APP_URL=https://app.comunora.com.br
API_PUBLIC_URL=https://api.comunora.com.br
CORS_ORIGINS=https://app.comunora.com.br,https://comunora.com.br

# ---- Web: expostas ao browser ----
NEXT_PUBLIC_SITE_URL=https://comunora.com.br
NEXT_PUBLIC_APP_URL=https://app.comunora.com.br
NEXT_PUBLIC_API_URL=https://api.comunora.com.br
NEXT_PUBLIC_DOCS_URL=https://docs.comunora.com.br
NEXT_PUBLIC_STATUS_URL=https://status.comunora.com.br
NEXT_PUBLIC_BRAND_NAME=Comunora
NEXT_PUBLIC_BRAND_SHORT_DESCRIPTION=Plataforma de atendimento inteligente que conecta WhatsApp, inteligencia artificial, CRM, automacoes e atendimento humano em uma unica operacao.
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@comunora.com.br

# ---- Login com Google ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.comunora.com.br/auth/google/callback

# ---- Google Calendar por tenant ----
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=https://api.comunora.com.br/integracoes/google-calendar/callback

# ---- Transporte WhatsApp / Evolution ----
TRANSPORTE_DRIVER=evolution
EVOLUTION_API_URL=https://evolution.comunora.com.br
EVOLUTION_API_KEY=

# ---- Billing: Asaas ----
BILLING_REQUIRED=true
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=Comunora/1.0

# ---- E-mail ----
RESEND_API_KEY=
EMAIL_FROM=Comunora <no-reply@comunora.com.br>

# ---- API publica ----
PUBLIC_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000

# ---- Webhooks outbound ----
WEBHOOK_OUT_MAX_ATTEMPTS=3
WEBHOOK_OUT_RETRY_BASE_DELAY_MS=750

# ---- IA / conhecimento ----
OPENAI_EMBEDDING_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SECRETS_PROVIDER=env

# ---- Meta legado / CTWA, se usado ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_CONFIG_ID=
META_REGISTER_PIN=000000
META_ACCESS_TOKEN=
META_DATASET_ID=
META_CAPI_TOKEN=
BSP_SOLUTION_ID=

# ---- Campanhas ----
ANTIBAN_TZ=America/Sao_Paulo
ANTIBAN_HORA_INICIO=8
ANTIBAN_HORA_FIM=20
ANTIBAN_DIAS=1,2,3,4,5
ANTIBAN_DELAY_MEDIO_MS=8000
ANTIBAN_DELAY_MIN_MS=3000
ANTIBAN_WARMUP_BASE=20
ANTIBAN_WARMUP_INCREMENTO=20
ANTIBAN_WARMUP_MAX=400
