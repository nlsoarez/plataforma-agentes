# ---- Banco ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma

# ---- Redis (fila + pub/sub) ----
REDIS_URL=redis://localhost:6379

# ---- WhatsApp Cloud API (Meta) ----
META_APP_SECRET=          # valida assinatura do webhook
META_VERIFY_TOKEN=        # token do handshake GET do webhook
META_GRAPH_VERSION=v21.0

# ---- Solution Partner (BSP) na fase inicial ----
BSP_SOLUTION_ID=

# ---- Cofre de segredos BYOK ----
# Em produção use Doppler/Vault. As CHAVES DE IA DOS CLIENTES NUNCA vão aqui.
SECRETS_PROVIDER=env

# ---- App ----
PORT=3000
NODE_ENV=development

# ---- Dev: token de acesso da Cloud API (em prod vem do cofre por numero) ----
META_ACCESS_TOKEN=
# Opcional por numero: WABA_TOKEN_<phone_number_id>=...

# ---- Dev: chave BYOK referenciada por agentes.byok_key_ref ----
# Ex: se o agente tem byok_key_ref='OPENAI_KEY_CLIENTE_A', defina:
# OPENAI_KEY_CLIENTE_A=sk-...

# ---- Auth ----
JWT_SECRET=                 # gere um segredo forte em producao

# ---- App Meta (Embedded Signup / onboarding) ----
META_APP_ID=
META_CONFIG_ID=             # id da configuracao de Embedded Signup
META_REGISTER_PIN=000000    # PIN de registro do numero (6 digitos)

# ---- Web (expostas ao browser) ----
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0

# ---- Conversions API (CTWA — conversoes de volta pro Meta Ads) ----
META_DATASET_ID=
META_CAPI_TOKEN=

# ---- Transporte (Fase 1 = evolution; Fase 2 = cloud_api) ----
TRANSPORTE_DRIVER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# URL publica da SUA api (pro Evolution mandar webhook). Ex no Railway: https://api-xxx.up.railway.app
API_PUBLIC_URL=
