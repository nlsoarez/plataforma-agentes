# ---- Banco ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma

# ---- Redis: fila + pub/sub ----
REDIS_URL=redis://localhost:6379

# ---- App ----
PORT=3000
NODE_ENV=development
JWT_SECRET=                 # gere um segredo forte em producao
SECRETS_MASTER_KEY=          # 32+ chars fortes para criptografar chaves BYOK no banco
# Em producao, liste apenas os dominios do painel separados por virgula.
CORS_ORIGINS=http://localhost:3001

# ---- Web: expostas ao browser ----
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0

# ---- Login com Google ----
# No Google Cloud Console, cadastre:
# http://localhost:3000/auth/google/callback
# ou a URL publica da API em producao.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
WEB_APP_URL=http://localhost:3001

# ---- Transporte WhatsApp ----
TRANSPORTE_DRIVER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# URL publica da API para a Evolution enviar webhooks.
# Exemplo: https://api-seuapp.up.railway.app
API_PUBLIC_URL=

# ---- API publica ----
PUBLIC_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000

# ---- Webhooks outbound ----
WEBHOOK_OUT_MAX_ATTEMPTS=3
WEBHOOK_OUT_RETRY_BASE_DELAY_MS=750

# ---- Agenda ----
# Webhook opcional para sincronizar agendamentos criados pelo agente com Google Calendar/n8n/Make.
CALENDAR_WEBHOOK_URL=

# ---- OpenAI / Base de conhecimento ----
# Chaves dos clientes devem ser configuradas no painel em /ai-settings.
# Este valor e opcional e usado apenas para embeddings globais/fallback.
OPENAI_EMBEDDING_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Cofre legado BYOK ----
SECRETS_PROVIDER=env
# Exemplo legado: se agentes.byok_key_ref='OPENAI_KEY_CLIENTE_A', defina:
# OPENAI_KEY_CLIENTE_A=sk-...

# ---- Meta: mantido apenas para recursos legados/CTWA ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_CONFIG_ID=
META_REGISTER_PIN=000000
META_ACCESS_TOKEN=
META_DATASET_ID=
META_CAPI_TOKEN=
BSP_SOLUTION_ID=

# ---- Anti-ban: campanhas via Evolution ----
ANTIBAN_TZ=America/Sao_Paulo
ANTIBAN_HORA_INICIO=8
ANTIBAN_HORA_FIM=20
ANTIBAN_DIAS=1,2,3,4,5
ANTIBAN_DELAY_MEDIO_MS=8000
ANTIBAN_DELAY_MIN_MS=3000
ANTIBAN_WARMUP_BASE=20
ANTIBAN_WARMUP_INCREMENTO=20
ANTIBAN_WARMUP_MAX=400

# ---- Billing: Asaas ----
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
