# ---- Banco ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma

# ---- Redis (fila + pub/sub) ----
REDIS_URL=redis://localhost:6379

# ---- WhatsApp Cloud API (Meta) ----
META_APP_SECRET=          # valida assinatura do webhook
META_VERIFY_TOKEN=        # token do handshake GET do webhook
META_GRAPH_VERSION=v21.0

# ---- Solution Partner (BSP) na fase inicial ----
BSP_SOLUTION_ID=

# ---- Cofre de segredos BYOK ----
# Em produção use Doppler/Vault. As CHAVES DE IA DOS CLIENTES NUNCA vão aqui.
SECRETS_PROVIDER=env

# ---- App ----
PORT=3000
NODE_ENV=development
